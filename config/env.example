# Settings of Claude-AI (read by the built-in server at start).
#
# This file lives in ~/Library/Application Support/Claude-AI/.env — the app creates it from
# config/env.example on the first start. Menu: Claude-AI → Настройки (.env)… (⌘,).
# Relative paths below are relative to that folder. Restart the server after editing:
# menu bar icon → Перезапустить сервер.

# --- Server ----------------------------------------------------------------------

# Port of the UI and of the test API (127.0.0.1 only). If it is taken when the app starts,
# the app offers to attach to the server running there or to use another port.
PORT=3000

# Command used to start Claude Code (found through the PATH of your login shell).
# CLAUDE_BIN=claude

# Project folder a new window starts in (default: your home folder).
# CLAUDE_CWD=~/projects

# Subagents of the main agent always run in the background (CLAUDE_CODE_FORK_SUBAGENT=1, as in the
# terminal and VS Code), so Claude reads messages typed while a subagent works. 0 = Claude decides.
# CLAUDE_WEB_BACKGROUND_AGENTS=1

# Minutes a chat's claude process waits for the next message after answering. The next message
# goes into the same process, so what lives in it survives between messages: MCP servers (the
# Chrome tab group of Claude in Chrome), background shell commands. 0 = exit after each answer.
# Over 60: the CLI compacts a 200K+ token conversation left idle at ~54 minutes (90% of the
# one-hour prompt cache), so the next message doesn't pay for re-caching it; that needs the process alive.
# CLAUDE_WEB_IDLE_KEEP_MIN=65

# Model for translating files in the viewer (RU / UA / EN in the preview of .md, .txt, .html) when
# the browser has no built-in translator — always inside the app. Default: the catalog's Haiku.
# CLAUDE_WEB_TRANSLATE_MODEL=claude-haiku-5-5

# --- Test API: /v1/chat/completions (OpenAI) and /v1/messages (Anthropic) ----------

# API key clients must send (Authorization: Bearer <key> or x-api-key: <key>).
# Empty: a key is generated once and kept in .run/api-key.
# CLAUDE_WEB_API_KEY=

# Model used when a request names no Claude model.
# CLAUDE_WEB_API_MODEL=claude-haiku-4-5

# Effort (claude --effort) when a request names none: low, medium, high, xhigh, max, or
# "default" for the CLI's own settings. A request picks its own with OpenAI reasoning_effort
# or Anthropic output_config.effort. Models without effort levels (Haiku 4.5) ignore it.
# CLAUDE_WEB_API_EFFORT=medium

# How many API requests may run at once; the rest wait in a queue.
# CLAUDE_WEB_API_CONCURRENCY=4

# Extra Host header values accepted by the API, comma-separated (e.g. a tunnel hostname).
# CLAUDE_WEB_API_HOSTS=claude.example.com

# --- Cloudflare Tunnel (publishes the API only; see config/cloudflared.yml.example) --

# Put cloudflared.yml next to this file and uncomment:
# CLAUDE_WEB_CLOUDFLARED=cloudflared.yml
# CLAUDE_WEB_CLOUDFLARED_BIN=/opt/homebrew/bin/cloudflared
# Address of cloudflared's metrics server (the menu bar reads live connections from its /ready).
# Default: 127.0.0.1:<PORT + 20000>.
# CLAUDE_WEB_CLOUDFLARED_METRICS=127.0.0.1:23000

# --- Silero voice ----------------------------------------------------------------------

# By default the app runs its built-in Silero voice (bundled; ~0.8 GB of memory while running).
# Turn it off (the page then uses the system voice):
# CLAUDE_WEB_TTS_LOCAL=0

# --- Image generation ---------------------------------------------------------------------------

# Claude's generate_image tool: Stable Diffusion XL on this Mac (MLX; needs the runtime from
# `npm run build:imagegen`), "fast" SDXL Turbo (~1 min) or "quality" Juggernaut XL (~5 min on 8 GB).
# The first image of each model downloads ~7 GB of weights into ~/.cache/huggingface;
# while loaded the generator takes 4-6 GB of memory and unloads after these minutes without use.
# CLAUDE_WEB_IMAGEGEN=0
# CLAUDE_WEB_IMAGEGEN_IDLE_MIN=5
# The same generator is also served by the test API as the OpenAI Images API:
# POST /v1/images/generations {prompt, model?, size?, quality?} -> {data: [{b64_json}]}, so a client that
# talks to OpenAI's images endpoint (e.g. LabiOne's IMAGE_API_BASE_URL) can be pointed here for testing.
# model: fast | sdxl-turbo | quality | juggernaut-xl; any other name -> quality when quality=high, else
# the default below. size "WxH" is fitted into 256-1024 in steps of 64. POST /v1/images/edits (multipart:
# image, prompt, model?, size?, strength? 0.05-1 = 0.6) re-renders one source image (no mask). Turn both
# endpoints off with CLAUDE_WEB_API_IMAGES=0.
# CLAUDE_WEB_API_IMAGES=0
# CLAUDE_WEB_API_IMAGE_MODEL=fast

# --- HTTPS (usually not needed in the app) -------------------------------------------

# CLAUDE_WEB_HTTPS_PORT=3443
# CLAUDE_WEB_TLS_CERT=.run/tls/localhost.pem
# CLAUDE_WEB_TLS_KEY=.run/tls/localhost-key.pem

# --- Process tracking -----------------------------------------------------------------

# CLAUDE_WEB_REGISTRY=.run/processes.json
# CLAUDE_WEB_JOURNAL=.run/shell-journal.log
