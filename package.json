{
  "name": "claude-wrapper",
  "displayName": "Claude Wrapper",
  "description": "%description%",
  "version": "1.6.0",
  "publisher": "ninebits",
  "icon": "resources/icon.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "os": [
    "darwin"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./extension.js",
  "scripts": {
    "pack": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "codicons": "cp node_modules/@vscode/codicons/dist/codicon.css node_modules/@vscode/codicons/dist/codicon.ttf media/codicons/"
  },
  "devDependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.0.0"
  },
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeWrapper",
          "title": "%container.projects%",
          "icon": "media/projects.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "claudeWrapperChat",
          "title": "Claude Wrapper",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "claudeWrapper": [
        {
          "type": "webview",
          "id": "claudeWrapper.projects",
          "name": "%view.projects%"
        }
      ],
      "claudeWrapperChat": [
        {
          "type": "webview",
          "id": "claudeWrapper.chat",
          "name": "%view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeWrapper.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.newChat",
        "title": "%cmd.newChat%",
        "icon": "$(add)",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.openProject",
        "title": "%cmd.openProject%",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.openProjectNewWindow",
        "title": "%cmd.openProjectNewWindow%",
        "icon": "$(empty-window)",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.relinkProject",
        "title": "%cmd.relinkProject%",
        "icon": "$(arrow-right)",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.openSession",
        "title": "%cmd.openSession%",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.deleteSession",
        "title": "%cmd.deleteSession%",
        "icon": "$(trash)",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.stopProcess",
        "title": "%cmd.stopProcess%",
        "icon": "$(debug-stop)",
        "category": "Claude Wrapper"
      },
      {
        "command": "claudeWrapper.stopAgent",
        "title": "%cmd.stopAgent%",
        "icon": "$(debug-stop)",
        "category": "Claude Wrapper"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeWrapper.refresh",
          "when": "view == claudeWrapper.projects",
          "group": "navigation@9"
        },
        {
          "command": "claudeWrapper.newChat",
          "when": "view == claudeWrapper.chat",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeWrapper.openProject",
          "when": "false"
        },
        {
          "command": "claudeWrapper.openProjectNewWindow",
          "when": "false"
        },
        {
          "command": "claudeWrapper.relinkProject",
          "when": "false"
        },
        {
          "command": "claudeWrapper.openSession",
          "when": "false"
        },
        {
          "command": "claudeWrapper.deleteSession",
          "when": "false"
        },
        {
          "command": "claudeWrapper.stopProcess",
          "when": "false"
        },
        {
          "command": "claudeWrapper.stopAgent",
          "when": "false"
        }
      ]
    }
  }
}
